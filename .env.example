# =============================================================================
# SmartCityAI — Production Environment Configuration (.env.example)
# Copy this file to .env and replace secrets before deploying
# NEVER commit production .env files to version control!
# =============================================================================

# --- Environment & Platform ---
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false

# --- PostgreSQL Relational Database ---
POSTGRES_USER=smartcity_admin
POSTGRES_PASSWORD=replace_with_64_char_crypto_random_password
POSTGRES_DB=smartcityai
POSTGRES_PORT=5432

# SQLAlchemy Connection URI (used by Backend & ML Worker containers)
DATABASE_URL=postgresql://smartcity_admin:replace_with_64_char_crypto_random_password@db:5432/smartcityai
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- API Security & Role-Based Access Control (RBAC) ---
# Generate via: openssl rand -hex 32
API_KEY_ADMIN=admin_replace_with_random_token_for_root_control
API_KEY_ANALYST=analyst_replace_with_random_token_for_ingestion
API_KEY_VIEWER=viewer_public_read_only_dashboard_token
SECRET_KEY=replace_with_random_hmac_salt_for_session_verification

# --- Cross-Origin Resource Sharing (CORS) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# --- ML Pipeline Worker Settings ---
ML_WORKER_INTERVAL_SECONDS=3600
DRIFT_PSI_ALERT_THRESHOLD=0.10
DRIFT_PSI_CRITICAL_THRESHOLD=0.25

# --- Ports Exposed on Host ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
